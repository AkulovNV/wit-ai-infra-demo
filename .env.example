# По умолчанию: локальная модель через Ollama на хосте (`ollama pull qwen2.5:7b`). Ключ провайдера не нужен.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# Другая модель: любой OpenAI-совместимый endpoint с tool calling (README, раздел «Самостоятельно»).
# Атака в сценарии C должна воспроизводиться 10/10: проверить `make test-c` на выбранной модели.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# LLM_API_KEY=

# Ключ подписи сессионных токенов tool-сервера (профиль secure)
TOOLS_SIGNING_KEY=local-demo-signing-key-change-me
# Ключ, с которым агент и guardrail ходят в LLM gateway (профиль secure). Должен начинаться с sk-.
# Стенд не публикует порты на хост. Для чего-то кроме локального демо сгенерируйте свои значения:
#   openssl rand -hex 32
GATEWAY_KEY=sk-local-demo-0f3c9a7e5b1d4826a9c07e3f5d2b8146
