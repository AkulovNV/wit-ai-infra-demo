# Любой OpenAI-совместимый endpoint с поддержкой tool calling.
# Атака в сценарии C должна воспроизводиться 10/10: проверить `make test-c` на выбранной модели.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Ключ подписи сессионных токенов tool-сервера (профиль secure)
TOOLS_SIGNING_KEY=change-me

# Ключ, с которым агент и guardrail ходят в LLM gateway (профиль secure). Должен начинаться с sk-:
#   echo "sk-$(openssl rand -hex 32)"
GATEWAY_KEY=
